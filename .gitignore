# ========== Python 基础 ==========
# 虚拟环境（必须忽略，不然上传几百兆）
venv/
.venv/
env/
ENV/

# 编译缓存（不需要）
__pycache__/
*.pyc
*.pyo
*.pyd

# ========== NLP 大模型缓存（关键！必须忽略，这是最大的文件）（只保留目录壳，忽略所有实体文件）==========
cache/*
!cache/.gitkeep
# 忽略所有二进制模型文件（防止个别遗漏）
*.bin

# ========== 日志文件 ==========
*.log
log/dashboard_debug.log

# ========== IDE 配置（PyCharm） ==========
.idea/
*.iml
.vscode/
.DS_Store

# ========== 数据库备份（保留真实数据，但忽略临时文件）==========
data/*.db-journal
data/*.wal

# ========== 模型文件（保留 .pkl，它们一般只有几MB，但如果你怕大，也可取消注释）==========
models/*.pkl

# ========== 前端依赖与构建产物 ==========
node_modules/
frontend/dist/

# ========== 工具/工作记忆目录（本地专用，勿上传）==========
.workbuddy/


